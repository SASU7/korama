{
  "name": "korama-investor-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "migration:check": "node scripts/migration-sanity.mjs",
    "api:acceptance": "node scripts/api-acceptance.mjs",
    "api:normalized:acceptance": "KORAMA_NORMALIZED_ACCEPTANCE=true node scripts/api-acceptance.mjs",
    "db:test": "supabase test db --local",
    "normalized:check": "node scripts/normalized-contract-check.mjs",
    "normalized:mutation:check": "node scripts/normalized-mutation-check.mjs",
    "auth:bootstrap": "node scripts/bootstrap-identities.mjs",
    "env:check": "node scripts/check-env.mjs",
    "staging:check": "node scripts/staging-preflight.mjs",
    "deployment:check": "node scripts/deployment-smoke.mjs",
    "bundle:check": "node scripts/client-bundle-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "1.37.0",
    "mapbox-gl": "^3.29.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "6.0.3"
  }
