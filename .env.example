# Hosted services are mandatory in every environment, including local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack test credentials. lib/paystack.ts refuses to start unless the
# secret begins with sk_test_ — this prototype must never hold a live key.
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

NEXT_PUBLIC_MAPBOX_TOKEN=

# Google OAuth client (Google Cloud console → APIs & Services → Credentials).
# Only needed to run `supabase config push`; the app itself never reads these.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
